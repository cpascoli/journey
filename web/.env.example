# Copy to web/.env.local for local development. Never commit real values.

# Supabase project (Settings → API). The service-role key is server-only:
# never expose it as NEXT_PUBLIC_*.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API keys, as a JSON array. Roles:
#   owner       the iPhone app: publishes entries, manages invites, decides proposals
#   agent       the ChatGPT GPT: reads entries, proposes story text
#   agent-read  read-only agent
# [{"name":"iphone","secret":"long-random-token","role":"owner"},
#  {"name":"chatgpt","secret":"another-long-random-token","role":"agent"}]
JOURNEY_API_KEYS=

# Signs short-lived owner dashboard sessions. Use an independent random value
# of at least 32 characters (for example: openssl rand -base64 32).
JOURNEY_SESSION_SECRET=

# Cloudflare R2, which holds published videos (Supabase Storage keeps photos).
# Create a bucket and an S3 API token in the Cloudflare dashboard. Server-only:
# never expose these as NEXT_PUBLIC_*. Leave them unset for local development
# and videos fall back to Supabase Storage, which is what the e2e scripts use.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
